# Google Gemini API Key (Free tier from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Facebook Page ID (Found in Page About/Transparency section)
FB_PAGE_ID=your_facebook_page_id_here

# Facebook Never-Expiring Page Access Token (From Meta for Developers / Graph API Explorer)
FB_ACCESS_TOKEN=your_facebook_page_access_token_here

